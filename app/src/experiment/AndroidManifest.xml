<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Reachable from the brrSpeak settings screen only. Do not add a second launcher
             icon: the user needs to configure providers first, and some launchers hide or
             rearrange additional MAIN/LAUNCHER activities after setup or a settings restore.
             The separate process ensures the RecognitionService cannot silently substitute
             its own microphone for caller-supplied PCM. -->
        <activity
            android:name="dev.patrickgold.florisboard.dictate.recognition.AudioSourceProbeActivity"
            android:process=":audio_source_probe"
            android:label="brrSpeak audio-source test"
            android:exported="false" />
    </application>
</manifest>
